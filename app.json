{
  "expo": {
    "name": "Heritage Hills",
    "slug": "heritage-hills",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heritagehills",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.heritagehills.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCEBE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.heritagehills.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E5A45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you add animal photos to Critter Club, and a photo of your pet if you ask for a pet portrait. A photo leaves your phone only if you ask.",
          "cameraPermission": "Lets you photograph animals for Critter Club, and your pet if you ask for a pet portrait. A photo leaves your phone only if you ask.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "supportsRTL": true,
      "demo": true
    }
  }
}
